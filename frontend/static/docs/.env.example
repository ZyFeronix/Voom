# =============================================================================
# Voom! - Environment Configuration Example
# Copy this file to .env and fill in your values
#
# ¿Despliegue con Docker/Portainer? Usa DEPLOY.md — solo necesitas DOMAIN.
# =============================================================================

# ------------------------------------------------------------------------
# Core Application
# ------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# URL pública absoluta en producción (cookies Secure, CSRF, emails):
# APP_URL es informativo; la que aplica de verdad en adapter-node es ORIGIN.
APP_URL=http://localhost:3000
# ORIGIN=https://voom.social

# Detrás de proxy inverso (Caddy/nginx) confiar en X-Forwarded-For:
# TRUST_PROXY=1
# Límite de cuerpo del servidor (debe >= tamaño máx. de subida):
# BODY_SIZE_LIMIT=52428800

# ------------------------------------------------------------------------
# Database (libSQL / SQLite)
# ------------------------------------------------------------------------
# SQLite file path relative to the project root or absolute path
DB_PATH=./database.sqlite

# libSQL remote URL (leave empty for local SQLite)
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# ------------------------------------------------------------------------
# Docker / directorios de datos (imagen Voom!)
# ------------------------------------------------------------------------
# Directorio de datos persistente (install.lock, .env, backups):
# DATA_DIR=/data
# Archivos subidos por los usuarios (absoluta o relativa a la raíz):
# UPLOAD_DIR=/data/uploads
# Ruta del esquema y de las migraciones (defaults: raíz del proyecto):
# SCHEMA_PATH=/app/schema_sqlite.sql
# MIGRATIONS_DIR=/app/migrations

# ------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------
# IMPORTANT: Generate a strong random secret for production!
# Use: openssl rand -base64 64
# (En Docker, si no la defines, el entrypoint la genera y persiste sola.)
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS_OR_MORE
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------
# File Uploads
# ------------------------------------------------------------------------
MAX_FILE_SIZE=10485760

# ------------------------------------------------------------------------
# Email (SMTP)
# ------------------------------------------------------------------------
# NOTA: en la aplicación el SMTP se configura desde /admin/apis (system_settings).
# Estas variables son solo referencia para despliegues manuales.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@voom.social

# ------------------------------------------------------------------------
# Web Push Notifications (Optional)
# ------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@voom.social

# ------------------------------------------------------------------------
# Demo / Maintenance
# ------------------------------------------------------------------------
# Estos flags de operación se gestionan desde /admin/system → system_settings
# (mantenimiento, modo demo, registro por invitación) — NO por entorno.
INSTALL_LOCK=false
